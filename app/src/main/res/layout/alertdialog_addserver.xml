<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_round" android:orientation="vertical" android:padding="22dp">
    <TextView android:id="@+id/dialogTitleAdd" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold" android:letterSpacing="0.1" android:text="SERVER  /  FAVORIT"
        android:textColor="#64CCFF" android:textSize="10sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:fontFamily="@font/montserrat_bold" android:text="Tambah server" android:textColor="#F8FAFC" android:textSize="21sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:fontFamily="@font/montserrat_regular" android:text="Masukkan alamat server untuk menyimpannya ke daftar favorit."
        android:textColor="#9AADC1" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
        android:fontFamily="@font/montserrat_bold" android:text="Alamat server" android:textColor="#E7F1FA" android:textSize="12sp" />
    <EditText android:id="@+id/server_host" android:layout_width="match_parent" android:layout_height="52dp"
        android:layout_marginTop="8dp" android:background="@drawable/bg_hope_field" android:fontFamily="@font/montserrat_regular"
        android:hint="IP atau domain:port" android:imeOptions="actionDone" android:inputType="textUri"
        android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="#FFFFFF"
        android:textColorHint="#7990A5" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:orientation="horizontal">
        <Button android:id="@+id/server_close" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
            android:layout_marginEnd="5dp" android:backgroundTint="#263B50" android:fontFamily="@font/montserrat_bold"
            android:text="Batal" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" />
        <Button android:id="@+id/server_add" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
            android:layout_marginStart="5dp" android:backgroundTint="#129FE4" android:fontFamily="@font/montserrat_bold"
            android:text="Simpan" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>

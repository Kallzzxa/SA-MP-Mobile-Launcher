<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_dialog_round" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold" android:letterSpacing="0.08"
        android:text="SERVER  /  PLAYERS" android:textColor="#64CCFF" android:textSize="10sp" />
    <TextView android:id="@+id/players_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:fontFamily="@font/montserrat_bold" android:text="Daftar pemain"
        android:textColor="#F8FAFC" android:textSize="20sp" />
    <TextView android:id="@+id/players_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:fontFamily="@font/montserrat_regular" android:lineSpacingExtra="2dp"
        android:text="Memuat daftar pemain..." android:textColor="#9AADC1" android:textSize="12sp" />
    <EditText android:id="@+id/players_search" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="10dp" android:background="@drawable/bg_hope_field"
        android:hint="Cari nama pemain" android:inputType="text" android:imeOptions="actionDone"
        android:singleLine="true" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:textColor="#F8FAFC" android:textColorHint="#8BA0B6" android:textSize="12sp" />
    <Spinner android:id="@+id/players_sort" android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="6dp" android:background="@drawable/bg_hope_field"
        android:contentDescription="Urutkan daftar pemain" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/players_list"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="12dp" android:clipToPadding="false" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <Button android:id="@+id/players_close" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:layout_marginEnd="4dp" android:backgroundTint="#263B50" android:fontFamily="@font/montserrat_bold"
            android:text="Tutup" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="12sp" />
        <Button android:id="@+id/players_refresh" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
            android:layout_marginStart="4dp" android:backgroundTint="#129FE4" android:fontFamily="@font/montserrat_bold"
            android:text="Perbarui" android:textAllCaps="false" android:textColor="#FFFFFF" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_round"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.08"
                android:text="SERVER DETAILS"
                android:textColor="#38BDF8"
                android:textSize="11sp" />
            <ImageView
                android:id="@+id/server_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Tutup"
                android:padding="11dp"
                app:srcCompat="@drawable/ic_close" />
        </LinearLayout>

        <TextView
            android:id="@+id/server_hostname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_bold"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="Server"
            android:textColor="#F8FAFC"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_server_card"
            android:orientation="vertical"
            android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ALAMAT SERVER" android:textColor="#94A3B8" android:textSize="10sp" />
            <TextView android:id="@+id/server_ip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/montserrat_medium" android:textColor="#F8FAFC" android:textSize="13sp" />
            <TextView android:id="@+id/server_port" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#94A3B8" android:textSize="12sp" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:background="#26384D" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="PEMAIN" android:textColor="#94A3B8" android:textSize="10sp" />
            <TextView android:id="@+id/server_online" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="@font/montserrat_medium" android:textColor="#F8FAFC" android:textSize="13sp" />
            <TextView android:id="@+id/server_mode" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:ellipsize="end" android:maxLines="2" android:textColor="#CBD5E1" android:textSize="12sp" />
            <TextView android:id="@+id/server_language" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:ellipsize="end" android:maxLines="1" android:textColor="#CBD5E1" android:textSize="12sp" />
            <TextView android:id="@+id/server_query_ping" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:text="Ping query: belum diukur" android:textColor="#8BD9FF" android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/server_players"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#26425A"
            android:fontFamily="@font/montserrat_bold"
            android:text="Lihat daftar pemain"
            android:textAllCaps="false"
            android:textColor="#DFF3FF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/server_measure_ping"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp"
            android:backgroundTint="#26425A" android:fontFamily="@font/montserrat_bold"
            android:text="Ukur ping server" android:textAllCaps="false" android:textColor="#DFF3FF" android:textSize="12sp" />
        <Button
            android:id="@+id/server_rules"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp"
            android:backgroundTint="#26425A" android:fontFamily="@font/montserrat_bold"
            android:text="Lihat info server" android:textAllCaps="false" android:textColor="#DFF3FF" android:textSize="12sp" />
        <Button
            android:id="@+id/server_copy_address"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp"
            android:backgroundTint="#26425A" android:fontFamily="@font/montserrat_bold"
            android:text="Salin alamat server" android:textAllCaps="false" android:textColor="#DFF3FF" android:textSize="12sp" />
        <Button
            android:id="@+id/server_add_favorite"
            android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp"
            android:backgroundTint="#26425A" android:fontFamily="@font/montserrat_bold"
            android:text="Simpan ke favorit" android:textAllCaps="false" android:textColor="#DFF3FF" android:textSize="12sp"
            android:visibility="gone" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:fontFamily="@font/montserrat_bold" android:text="Nickname" android:textColor="#F8FAFC" android:textSize="12sp" />
        <EditText
            android:id="@+id/server_password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_hope_field"
            android:fontFamily="@font/montserrat_regular"
            android:hint="Nama pemain"
            android:inputType="textNoSuggestions"
            android:maxLength="24"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:fontFamily="@font/montserrat_bold" android:text="Password server (opsional)" android:textColor="#F8FAFC" android:textSize="12sp" />
        <EditText
            android:id="@+id/server_join_password"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_hope_field"
            android:hint="Kosongkan jika tidak diperlukan"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:maxLength="127"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#94A3B8"
            android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Password server tersimpan dalam konfigurasi game di perangkat." android:textColor="#94A3B8" android:textSize="10sp" />

        <TextView
            android:id="@+id/server_reporting_notice"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:textColor="#A8C9DE" android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/server_connect"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#129FE4"
            android:fontFamily="@font/montserrat_bold"
            android:text="Masuk server"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/save_favorites"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#243348"
            android:fontFamily="@font/montserrat_medium"
            android:text="Hapus favorit"
            android:textAllCaps="false"
            android:textColor="#F8FAFC" />
    </LinearLayout>
</ScrollView>

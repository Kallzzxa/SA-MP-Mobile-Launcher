<?xml version="1.0" encoding="utf-8"?>
<!-- Satu baris file di dialog "Downloading Assets" (di-inflate per file). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_asset_item"
    android:padding="10dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <TextView
            android:id="@+id/tv_file_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="file"
            android:textColor="#F4F4F5"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_file_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Queued"
            android:textColor="#71717A"
            android:textSize="11sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_file"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#DC2626"
        android:progressBackgroundTint="#27272A" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    android:background="@drawable/bg_card_detail"
    android:padding="20dp">

    <ImageView
        android:id="@+id/btn_close_detail"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="#2D3238"
        android:padding="7dp"
        app:srcCompat="@android:drawable/ic_menu_close_clear_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/btn_delete_server"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="#2D3238"
        android:padding="7dp"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_delete"
        app:layout_constraintEnd_toStartOf="@id/btn_close_detail"
        app:layout_constraintTop_toTopOf="@id/btn_close_detail" />

    <TextView
        android:id="@+id/det_server_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_bold"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="server 1"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btn_close_detail"
        app:layout_constraintBottom_toBottomOf="@id/btn_close_detail" />

    <!-- Badge trạng thái online/offline thực tế, cập nhật theo kết quả query SA-MP thật -->
    <LinearLayout
        android:id="@+id/status_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_status_badge"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        app:layout_constraintStart_toEndOf="@id/det_server_name"
        app:layout_constraintEnd_toStartOf="@id/btn_close_detail"
        app:layout_constraintTop_toTopOf="@id/det_server_name"
        app:layout_constraintBottom_toBottomOf="@id/det_server_name">

        <View
            android:id="@+id/status_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:background="@drawable/bg_dot_gray" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Checking..."
            android:textColor="#8A8F98"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:id="@+id/info_divider_top"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="#22FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/det_server_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ROW: Address -->
    <LinearLayout
        android:id="@+id/row_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/info_divider_top"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Address"
            android:textColor="#8A8F98"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/det_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_bold"
            android:text="142.132.203.47:15613"
            android:textColor="#FFC933"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ROW: Players -->
    <LinearLayout
        android:id="@+id/row_players"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/row_address"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Players"
            android:textColor="#8A8F98"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/det_players"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_bold"
            android:text="0 / 1000"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ROW: Ping -->
    <LinearLayout
        android:id="@+id/row_ping"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/row_players"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="Ping"
            android:textColor="#8A8F98"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/det_ping"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="end"
            android:fontFamily="@font/montserrat_bold"
            android:text="195 ms"
            android:textColor="#3DDC84"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/lbl_chart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Ping History (ms)"
        android:textColor="#8A8F98"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/row_ping" />

    <androidx.cardview.widget.CardView
        android:id="@+id/chart_card"
        android:layout_width="0dp"
        android:layout_height="140dp"
        android:layout_marginTop="6dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="#14171C"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/lbl_chart"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/ping_line_chart"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp" />

    </androidx.cardview.widget.CardView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_play_game"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:clickable="true"
        android:focusable="true"
        app:backgroundTint="#FFC933"
        app:fabSize="normal"
        app:elevation="4dp"
        app:srcCompat="@android:drawable/ic_media_play"
        app:tint="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chart_card" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="24dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/iv_logo"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:contentDescription="@string/hopepride_logo_description"
                    app:srcCompat="@drawable/hopepride_logo" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold"
                        android:letterSpacing="0.09"
                        android:text="HOPEPRIDE"
                        android:textColor="#F8FAFC"
                        android:textSize="16sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:fontFamily="@font/montserrat_medium"
                        android:text="ROLEPLAY  /  MOBILE"
                        android:textColor="#38BDF8"
                        android:textSize="10sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_server_tabs"
                    android:fontFamily="@font/montserrat_bold"
                    android:paddingStart="10dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="6dp"
                    android:text="LAUNCHER"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_hopepride_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:adjustViewBounds="true"
                android:background="@drawable/bg_banner_rounded"
                android:clipToOutline="true"
                android:contentDescription="@string/hopepride_banner_description"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/hopepride_banner" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="Siap untuk bermain?"
                android:textColor="#F8FAFC"
                android:textSize="22sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/montserrat_regular"
                android:lineSpacingExtra="3dp"
                android:text="Pastikan data game siap, lalu pilih server favoritmu."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/card_data_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_server_card"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:letterSpacing="0.08"
                    android:text="STATUS GAME DATA"
                    android:textColor="#38BDF8"
                    android:textSize="10sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <View
                        android:id="@+id/dot_status"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/bg_dot_red" />
                    <TextView
                        android:id="@+id/tv_data_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Memeriksa data..."
                        android:textColor="#F8FAFC"
                        android:textSize="15sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/tv_data_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:lineSpacingExtra="3dp"
                    android:text="Memeriksa file game..."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
                <ProgressBar
                    android:id="@+id/pb_download"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="14dp"
                    android:progressDrawable="@drawable/download_progress"
                    android:progressTint="#0284C7"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/tv_download_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/montserrat_medium"
                    android:text="0%"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:visibility="gone" />
                <LinearLayout
                    android:id="@+id/layout_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btn_verify_data"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="#243348"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Periksa"
                        android:textAllCaps="false"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/btn_download_data"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:backgroundTint="#0284C7"
                        android:fontFamily="@font/montserrat_bold"
                        android:text="Unduh data"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_server_card"
                android:orientation="vertical"
                android:padding="18dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserrat_bold"
                    android:text="Data manual"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:fontFamily="@font/montserrat_regular"
                    android:lineSpacingExtra="3dp"
                    android:text="Sudah punya data GTA SA? Letakkan file di folder berikut."
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/tv_manual_path"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_server_tabs"
                    android:fontFamily="@font/montserrat_medium"
                    android:padding="12dp"
                    android:text="Android/data/com.sampmobile.xyvern/files"
                    android:textColor="#38BDF8"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </LinearLayout>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/montserrat_medium"
                android:gravity="center"
                android:text="@string/launcher_developers"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

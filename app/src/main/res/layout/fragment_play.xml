<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080F1A">

    <LinearLayout
        android:id="@+id/server_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="22dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:letterSpacing="0.12"
            android:text="HOPEPRIDE  /  PLAY"
            android:textColor="#38BDF8"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Pilih server"
            android:textColor="#F8FAFC"
            android:textSize="25sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserrat_regular"
            android:text="Temukan server atau tambahkan alamat favoritmu."
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/tab_layout"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="22dp"
        android:background="@drawable/bg_server_tabs"
        android:orientation="horizontal"
        android:padding="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/server_header">

        <TextView
            android:id="@+id/tab_favorites"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_hope_nav_selected"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:text="Favorit"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tab_hosted"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:text="Hosted"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/search_servers"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_hope_field"
        android:fontFamily="@font/montserrat_regular"
        android:hint="Cari nama atau alamat server"
        android:inputType="text"
        android:imeOptions="actionDone"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:singleLine="true"
        android:textColor="#F8FAFC"
        android:textColorHint="#8BA0B6"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/refresh_servers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tab_layout" />

    <Button
        android:id="@+id/refresh_servers"
        android:layout_width="96dp"
        android:layout_height="48dp"
        android:layout_marginEnd="22dp"
        android:backgroundTint="#26425A"
        android:fontFamily="@font/montserrat_bold"
        android:text="Muat ulang"
        android:textAllCaps="false"
        android:textColor="#DFF3FF"
        android:textSize="10sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/search_servers" />

    <Spinner
        android:id="@+id/server_sort"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_hope_field"
        android:contentDescription="Urutkan daftar server"
        android:popupBackground="#263B50"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_servers" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_servers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:clipToPadding="false"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/btn_add_server"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/server_sort" />

    <TextView
        android:id="@+id/empty_servers"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        android:fontFamily="@font/montserrat_regular"
        android:gravity="center"
        android:lineSpacingExtra="5dp"
        android:textColor="#94A3B8"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/rv_servers"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/rv_servers" />

    <Button
        android:id="@+id/btn_add_server"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="22dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="18dp"
        android:backgroundTint="#129FE4"
        android:fontFamily="@font/montserrat_bold"
        android:text="+  Tambah server"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#080F1A" android:fillViewport="true" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingStart="22dp" android:paddingEnd="22dp"
        android:paddingTop="26dp" android:paddingBottom="28dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold" android:letterSpacing="0.12"
            android:text="HOPEPRIDE  /  LAUNCHER" android:textColor="#59C8FF" android:textSize="10sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:fontFamily="@font/montserrat_bold"
            android:text="Pengaturan" android:textColor="#F5F9FF" android:textSize="26sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:fontFamily="@font/montserrat_regular"
            android:text="Atur pengalaman bermain sesuai keinginanmu." android:textColor="#9AADC1" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/bg_hope_surface"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold" android:letterSpacing="0.08"
                android:text="01  /  PROFIL PEMAIN" android:textColor="#63CAFA" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:fontFamily="@font/montserrat_regular"
                android:text="Identitas dan versi yang digunakan saat bermain." android:textColor="#90A6BC" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:fontFamily="@font/montserrat_bold"
                android:text="Nickname" android:textColor="#E7F1FA" android:textSize="12sp" />
            <EditText android:id="@+id/settings_nickname" android:layout_width="match_parent" android:layout_height="52dp"
                android:layout_marginTop="8dp" android:background="@drawable/bg_hope_field" android:fontFamily="@font/montserrat_medium"
                android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:maxLength="24"
                android:inputType="textNoSuggestions" android:hint="Nama pemain" android:textColor="#F5F9FF" android:textColorHint="#6E8499" android:textSize="13sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:fontFamily="@font/montserrat_bold"
                android:text="Versi SA-MP" android:textColor="#E7F1FA" android:textSize="12sp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_hope_field">
                <Spinner android:id="@+id/spinner" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@android:color/transparent" android:popupBackground="#101C2C" android:paddingStart="6dp" android:paddingEnd="30dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="match_parent" android:layout_gravity="end"
                    android:gravity="center" android:paddingStart="12dp" android:paddingEnd="16dp" android:text="⌄"
                    android:textColor="#79D5FF" android:textSize="18sp" android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/bg_hope_surface"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold" android:letterSpacing="0.08"
                android:text="02  /  PENGALAMAN BERMAIN" android:textColor="#63CAFA" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:fontFamily="@font/montserrat_regular"
                android:text="Sesuaikan fitur launcher dan game." android:textColor="#90A6BC" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingTop="10dp" android:paddingBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold" android:text="Keyboard Android"
                        android:textColor="#EFF7FF" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular"
                        android:text="Gunakan keyboard bawaan perangkat." android:textColor="#90A6BC" android:textSize="11sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/keyboard_switch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:contentDescription="Keyboard Android" android:enabled="true"
                    app:thumbTint="@color/hope_switch_thumb" app:trackTint="@color/hope_switch_track" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#26394D" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingTop="10dp" android:paddingBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold" android:text="Voice chat"
                        android:textColor="#EFF7FF" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular"
                        android:text="Aktifkan komunikasi suara." android:textColor="#90A6BC" android:textSize="11sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/voice_switch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:contentDescription="Voice chat" android:enabled="true"
                    app:thumbTint="@color/hope_switch_thumb" app:trackTint="@color/hope_switch_track" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#26394D" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingTop="10dp" android:paddingBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold" android:text="Tampilkan FPS"
                        android:textColor="#EFF7FF" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular"
                        android:text="Tampilkan penghitung frame di game." android:textColor="#90A6BC" android:textSize="11sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/fps_switch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:contentDescription="Tampilkan FPS" android:enabled="true"
                    app:thumbTint="@color/hope_switch_thumb" app:trackTint="@color/hope_switch_track" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#26394D" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingTop="10dp" android:paddingBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold" android:text="Modified data"
                        android:textColor="#EFF7FF" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular"
                        android:text="Gunakan data game yang dimodifikasi." android:textColor="#90A6BC" android:textSize="11sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/modify_switch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:contentDescription="Modified data" android:enabled="true"
                    app:thumbTint="@color/hope_switch_thumb" app:trackTint="@color/hope_switch_track" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#26394D" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingTop="10dp" android:paddingBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold" android:text="AML"
                        android:textColor="#EFF7FF" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular"
                        android:text="Pengaturan Android Mod Loader." android:textColor="#90A6BC" android:textSize="11sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/aml_switch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:contentDescription="AML" android:enabled="true"
                    app:thumbTint="@color/hope_switch_thumb" app:trackTint="@color/hope_switch_track" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#26394D" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingTop="10dp" android:paddingBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold" android:text="CEF WebView"
                        android:textColor="#EFF7FF" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular"
                        android:text="Tampilan web untuk server yang mendukung." android:textColor="#90A6BC" android:textSize="11sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/cef_switch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:contentDescription="CEF WebView" android:enabled="true"
                    app:thumbTint="@color/hope_switch_thumb" app:trackTint="@color/hope_switch_track" />
            </LinearLayout>
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#26394D" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="68dp" android:gravity="center_vertical" android:orientation="horizontal"
                android:paddingTop="10dp" android:paddingBottom="10dp">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold" android:text="CLEO"
                        android:textColor="#EFF7FF" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular"
                        android:text="Belum tersedia di launcher ini." android:textColor="#90A6BC" android:textSize="11sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/cleo_switch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:contentDescription="CLEO" android:enabled="false"
                    app:thumbTint="@color/hope_switch_thumb" app:trackTint="@color/hope_switch_track" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/bg_hope_surface"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold" android:letterSpacing="0.08"
                android:text="03  /  TAMPILAN &amp; PERFORMA" android:textColor="#63CAFA" android:textSize="11sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="7dp" android:fontFamily="@font/montserrat_regular"
                android:text="Atur jumlah pesan dan batas frame." android:textColor="#90A6BC" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_bold" android:text="Pesan chat" android:textColor="#EFF7FF" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular" android:text="Jumlah pesan yang ditampilkan." android:textColor="#90A6BC" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:id="@+id/messages_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_hope_badge" android:fontFamily="@font/montserrat_bold" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="9" android:textColor="#8BD9FF" android:textSize="12sp" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatSeekBar android:id="@+id/messages_seekbar" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="2dp" android:contentDescription="Pesan chat" android:max="3" android:progress="1" android:progressTint="#33B9F7" android:thumbTint="#8BD9FF" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#26394D" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/montserrat_bold" android:text="Batas FPS" android:textColor="#EFF7FF" android:textSize="13sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular" android:text="Sesuaikan dengan performa perangkat." android:textColor="#90A6BC" android:textSize="11sp" />
                </LinearLayout>
                <TextView android:id="@+id/fps_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_hope_badge" android:fontFamily="@font/montserrat_bold" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:text="60" android:textColor="#8BD9FF" android:textSize="12sp" />
            </LinearLayout>
            <androidx.appcompat.widget.AppCompatSeekBar android:id="@+id/fps_seekbar" android:layout_width="match_parent" android:layout_height="36dp" android:layout_marginTop="2dp" android:contentDescription="Batas FPS" android:max="3" android:progress="1" android:progressTint="#33B9F7" android:thumbTint="#8BD9FF" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:background="@drawable/bg_hope_surface"
            android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_bold" android:letterSpacing="0.08"
                android:text="04  /  PRIVASI" android:textColor="#63CAFA" android:textSize="11sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginEnd="12dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:fontFamily="@font/montserrat_bold" android:text="Laporan percobaan masuk"
                        android:textColor="#EFF7FF" android:textSize="13sp" />
                    <TextView android:id="@+id/event_reporting_description" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="5dp" android:fontFamily="@font/montserrat_regular" android:lineSpacingExtra="2dp"
                        android:text="Aktif secara default jika dikonfigurasi; dapat dimatikan di sini. Alamat dan port server dikirim saat mencoba masuk. Relay dapat melihat IP internet; nickname dan password tidak dikirim."
                        android:textColor="#90A6BC" android:textSize="11sp" />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat android:id="@+id/event_reporting_switch"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:contentDescription="Laporan percobaan masuk" app:thumbTint="@color/hope_switch_thumb"
                    app:trackTint="@color/hope_switch_track" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp"
            android:fontFamily="@font/montserrat_medium" android:gravity="center" android:text="@string/launcher_developers"
            android:textColor="#71869C" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="14dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/tv_server_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="SERVER NAME |"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textAllCaps="true"
        android:fontFamily="@font/montserrat_bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iv_lock"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginTop="8dp"
        app:srcCompat="@drawable/ic_password_on"
        app:tint="#00E676"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_server_name" />

    <TextView
        android:id="@+id/tv_server_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="Address: 127.0.0.1:7777"
        android:textColor="#8A8F98"
        android:textSize="12sp"
        android:fontFamily="@font/montserrat_regular"
        app:layout_constraintStart_toEndOf="@id/iv_lock"
        app:layout_goneMarginStart="0dp"
        app:layout_constraintTop_toTopOf="@id/iv_lock"
        app:layout_constraintBottom_toBottomOf="@id/iv_lock"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_server_mode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Gamemode: Unknown"
        android:textColor="#8A8F98"
        android:textSize="12sp"
        android:fontFamily="@font/montserrat_regular"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_lock"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_server_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Players: 0 / 100"
        android:textColor="#8A8F98"
        android:textSize="12sp"
        android:fontFamily="@font/montserrat_regular"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_server_mode"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#1AFFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tv_server_status"
        tools:layout_editor_absoluteX="-16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
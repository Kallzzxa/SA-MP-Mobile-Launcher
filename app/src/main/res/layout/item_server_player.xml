<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp"
    android:background="@drawable/bg_hope_field" android:orientation="vertical" android:padding="12dp">
    <TextView android:id="@+id/player_name" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:ellipsize="end" android:maxLines="1" android:fontFamily="@font/montserrat_bold" android:textColor="#F4F9FF" android:textSize="13sp" />
    <TextView android:id="@+id/player_stats" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:fontFamily="@font/montserrat_regular" android:textColor="#9AADC1" android:textSize="11sp" />
</LinearLayout>
